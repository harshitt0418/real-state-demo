# =================================================================
# MIRĀS Real Estate Advisory API - Environment Configuration
# =================================================================

# Server Port
PORT=5001

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# MongoDB Connection String (e.g. Local MongoDB or MongoDB Atlas URI)
# NOTE: If MongoDB is not configured or cannot be reached, the server
# automatically falls back to the in-memory sample database with zero errors!
MONGODB_URI=mongodb://127.0.0.1:27017/miras_real_estate

# Allowed CORS Origin for Client Application
CLIENT_URL=http://localhost:5173

# Optional: Company Inquiry Channel Defaults
CONTACT_EMAIL=advisory@miras-re.sa
CONTACT_WHATSAPP=+966501234567
